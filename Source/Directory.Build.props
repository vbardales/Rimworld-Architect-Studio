<Project>

  <PropertyGroup>
    <!--
      Les intermediaires de compilation restent a la racine du depot, hors du dossier Mod/.
      Ce dossier part tel quel sur le Workshop - SteamUGC.SetItemContent y envoie le repertoire
      entier, sans aucun filtrage - donc rien d'autre que le mod ne doit s'y trouver.
      Doit rester dans un Directory.Build.props : la restauration NuGet lit cette propriete
      avant le csproj.
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.build\obj\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.build\bin\</BaseOutputPath>
  </PropertyGroup>

</Project>
