# Build intermediates.
# Directory.Build.props sends them outside the mod folder: they must never end up in it,
# since the whole folder goes to the Workshop as it stands.
.build/
Source/obj/
Source/bin/


# Development environments
.vs/
.vscode/
.idea/
*.user
*.suo
*.csproj.user

# Claude Code session worktrees and local settings. A session creates its worktree in the
# current directory, so sometimes inside this one, and each is a full copy of the repository.
# Until this folder became a repository of its own the rule lived in the monorepo's .gitignore,
# a file this repository does not carry.
.claude/

# Fiches de vitrine : elles ne sont pas publiables, et PUBLISHING.md demande de les effacer
# une fois Preview.png et ModIcon.png faits. A tout niveau, pas seulement a la racine.
PROMPT_*.md
**/PROMPT_*.md
.firecrawl/
